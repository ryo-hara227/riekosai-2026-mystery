/** 新しいスプレッドシート・新しいApps Scriptプロジェクトで使用してください。 */
const HERO_BOARD_SETTINGS={boardId:'hero-puzzle-2026',sheetName:'HeroMessages',readOnly:false,moderated:false,maxChars:200,startsAt:'',endsAt:''};
const HERO_HEADERS=['timestamp','penName','message','room','cardStyle','visible','requestId'];
const HERO_ROOMS=['general','easy','normal','hard','extra'];
const HERO_STYLES=['speech','comic','sticky','poster','hero'];
function heroJson_(value){return ContentService.createTextOutput(JSON.stringify(Object.assign({boardId:HERO_BOARD_SETTINGS.boardId},value))).setMimeType(ContentService.MimeType.JSON);}
function heroSheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('新規掲示板用のSPREADSHEET_IDが未設定です。');const sh=SpreadsheetApp.openById(id).getSheetByName(HERO_BOARD_SETTINGS.sheetName);if(!sh)throw new Error('先にsetupを実行してください。');return sh;}
function setup(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('新規のスプレッドシートIDを設定してください。');const ss=SpreadsheetApp.openById(id);const sh=ss.getSheetByName(HERO_BOARD_SETTINGS.sheetName)||ss.insertSheet(HERO_BOARD_SETTINGS.sheetName);if(sh.getLastRow()===0){sh.appendRow(HERO_HEADERS);sh.setFrozenRows(1);}if(JSON.stringify(sh.getRange(1,1,1,HERO_HEADERS.length).getValues()[0])!==JSON.stringify(HERO_HEADERS))throw new Error('新規シートのヘッダーを確認してください。');}
function heroCheckBoard_(p){if(p.boardId!==HERO_BOARD_SETTINGS.boardId)throw new Error('謎解き専用の掲示板IDが一致しません。');}
function doGet(e){try{const p=(e&&e.parameter)||{};heroCheckBoard_(p);const room=HERO_ROOMS.includes(p.room)?p.room:'general';const rows=heroSheet_().getDataRange().getValues().slice(1);const messages=rows.filter(r=>(r[5]===true||String(r[5]).toLowerCase()==='true')&&String(r[3])===room).slice(-100).map(r=>({penName:String(r[1]),message:String(r[2]),room:String(r[3]),cardStyle:String(r[4])}));return heroJson_({ok:true,messages});}catch(error){return heroJson_({ok:false,error:'掲示板を取得できません。新規デプロイとシート設定を確認してください。'});}}
function doPost(e){const lock=LockService.getScriptLock();try{if(!lock.tryLock(10000))throw new Error('混雑しています。少し待ってください。');const p=(e&&e.parameter)||{};heroCheckBoard_(p);if(HERO_BOARD_SETTINGS.readOnly)throw new Error('現在は閲覧専用です。');const now=Date.now();['startsAt','endsAt'].forEach(k=>{if(HERO_BOARD_SETTINGS[k]&&!Number.isFinite(Date.parse(HERO_BOARD_SETTINGS[k])))throw new Error('受付期間の設定を確認してください。');});if(HERO_BOARD_SETTINGS.startsAt&&now<Date.parse(HERO_BOARD_SETTINGS.startsAt))throw new Error('受付開始前です。');if(HERO_BOARD_SETTINGS.endsAt&&now>=Date.parse(HERO_BOARD_SETTINGS.endsAt))throw new Error('受付は終了しました。');const name=String(p.penName||'').trim(),message=String(p.message||'').trim();if(!name||Array.from(name).length>30||!message||Array.from(message).length>HERO_BOARD_SETTINGS.maxChars)throw new Error('名前と本文の文字数を確認してください。');if(!HERO_ROOMS.includes(p.room)||!HERO_STYLES.includes(p.cardStyle))throw new Error('投稿先かスタイルが不正です。');if(p.consent!=='true')throw new Error('公開への同意が必要です。');if(!/^[a-zA-Z0-9-]{16,80}$/.test(p.requestId||''))throw new Error('投稿IDが不正です。');const sh=heroSheet_(),rows=sh.getDataRange().getValues();if(rows.slice(1).some(r=>String(r[6])===p.requestId))return heroJson_({ok:true,pending:HERO_BOARD_SETTINGS.moderated,duplicate:true});const literal=s=>/^[=+@-]/.test(s)?"'"+s:s;sh.appendRow([new Date(),literal(name),literal(message),p.room,p.cardStyle,!HERO_BOARD_SETTINGS.moderated,p.requestId]);return heroJson_({ok:true,pending:HERO_BOARD_SETTINGS.moderated});}catch(error){return heroJson_({ok:false,error:error.message});}finally{if(lock.hasLock())lock.releaseLock();}}
